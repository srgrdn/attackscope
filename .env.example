# Optional: copy to .env. Source secrets are generated by the CLI into private files.
ATTACKSCOPE_UI_PORT=8180
ATTACKSCOPE_LOG_LEVEL=info
# Database path inside the backend container (persistent volume: /data).
ATTACKSCOPE_DATABASE_PATH=/data/attackscope.db

# Ingestion/read API bounds. Retention cleanup jobs arrive in Stage 8.
ATTACKSCOPE_DETAIL_RETENTION_DAYS=30
ATTACKSCOPE_DEDUP_RETENTION_DAYS=30
ATTACKSCOPE_MAX_BODY_BYTES=1048576
ATTACKSCOPE_MAX_BATCH_EVENTS=500
ATTACKSCOPE_MAX_API_CONCURRENCY=16
ATTACKSCOPE_SOURCE_REQUESTS_PER_SECOND=5
ATTACKSCOPE_SOURCE_BURST=10
ATTACKSCOPE_SOURCE_CONCURRENCY=2
ATTACKSCOPE_WRITE_WAIT_SECONDS=0.25
ATTACKSCOPE_QUERY_TIMEOUT_SECONDS=5
ATTACKSCOPE_BODY_TIMEOUT_SECONDS=5

# Retention / deterministic rule thresholds
ATTACKSCOPE_AGGREGATE_RETENTION_DAYS=365
ATTACKSCOPE_SSH_WINDOW_SECONDS=300
ATTACKSCOPE_SSH_FAILURE_THRESHOLD=10
ATTACKSCOPE_WEB_RATE_WINDOW_SECONDS=60
ATTACKSCOPE_WEB_REQUEST_THRESHOLD=120
ATTACKSCOPE_WEB_PATHS_WINDOW_SECONDS=300
ATTACKSCOPE_WEB_PATH_THRESHOLD=30
ATTACKSCOPE_PORT_WINDOW_SECONDS=300
ATTACKSCOPE_PORT_THRESHOLD=10
ATTACKSCOPE_BACKEND_MEMORY_LIMIT=512m
ATTACKSCOPE_FRONTEND_MEMORY_LIMIT=128m
