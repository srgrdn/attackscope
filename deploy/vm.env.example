# Copy as .env in the VM release directory; adjust UID/GID, paths and image tags.
# Keep both files selected, including when using docker compose without -f.
COMPOSE_FILE=compose.yaml:deploy/compose.vm.yaml
COMPOSE_PROJECT_NAME=attackscope
ATTACKSCOPE_BACKEND_IMAGE=attackscope-backend:vm-0.1-20261103
ATTACKSCOPE_FRONTEND_IMAGE=attackscope-frontend:vm-0.1-20261103
ATTACKSCOPE_VM_UID=1002
ATTACKSCOPE_VM_GID=1002
ATTACKSCOPE_RUN_DIR=/srv/attackscope/run
